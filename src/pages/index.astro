// GillisT Enterprises public site
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="GillisT Enterprises — thoughtful technology and advisory for complex environments." />
  <meta name="theme-color" content="#0b1220" />
  <title>GillisT Enterprises</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/styles.css" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <div class="glow glow-a" aria-hidden="true"></div>
  <div class="glow glow-b" aria-hidden="true"></div>

  <header class="site-header">
    <a class="brand" href="#top" aria-label="GillisT Enterprises home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">GillisT <em>Enterprises</em></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="#work">Focus</a>
      <a href="#approach">Approach</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <p class="eyebrow">Independent practice</p>
      <h1>
        Clarity for systems<br />
        <span class="serif-accent">that do not stand still.</span>
      </h1>
      <p class="lede">
        GillisT Enterprises works at the intersection of technology, judgment,
        and operational discretion—helping organizations make sense of complex
        tools, signals, and decisions.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Start a conversation</a>
        <a class="btn btn-ghost" href="#work">What we explore</a>
      </div>
    </section>

    <section id="work" class="section">
      <div class="section-head">
        <h2>Focus areas</h2>
        <p>Selected themes. Engagements are scoped privately and tailored to context.</p>
      </div>
      <div class="cards">
        <article class="card">
          <div class="card-index">01</div>
          <h3>Applied intelligence</h3>
          <p>
            Practical evaluation and integration of modern AI capabilities into
            real workflows—measured, deliberate, and free of theater.
          </p>
        </article>
        <article class="card">
          <div class="card-index">02</div>
          <h3>Strategic advisory</h3>
          <p>
            Quiet counsel on technology choices, risk posture, and the human
            factors that shape durable outcomes in uncertain environments.
          </p>
        </article>
        <article class="card">
          <div class="card-index">03</div>
          <h3>Research &amp; insight</h3>
          <p>
            Structured exploration of emerging behaviors in digital systems—
            oriented toward understanding, resilience, and responsible use.
          </p>
        </article>
      </div>
    </section>

    <section id="approach" class="section section-alt">
      <div class="split">
        <div>
          <h2>How we work</h2>
          <p class="lede-sm">
            Small surface area. High signal. No unnecessary process.
          </p>
        </div>
        <ul class="principles">
          <li>
            <strong>Discretion first</strong>
            <span>Client matters stay confidential by default.</span>
          </li>
          <li>
            <strong>Substance over spectacle</strong>
            <span>Recommendations you can implement—not slideware.</span>
          </li>
          <li>
            <strong>Context aware</strong>
            <span>Every engagement respects operational and human constraints.</span>
          </li>
          <li>
            <strong>Long horizon</strong>
            <span>Prefer durable capability over short-lived novelty.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section band">
      <blockquote>
        <p>
          “We help teams see clearly when tools, incentives, and information
          move faster than the institutions around them.”
        </p>
        <footer>— GillisT Enterprises</footer>
      </blockquote>
    </section>

    <section id="contact" class="section">
      <div class="contact-panel">
        <div>
          <h2>Contact</h2>
          <p>
            For inquiries, introductions, or carefully scoped engagements,
            reach out by email. We respond when a fit is genuine.
          </p>
        </div>
        <div class="contact-actions">
          <a class="btn btn-primary" href="mailto:admin@gillist.com">admin@gillist.com</a>
          <p class="fine">
            Based in the United States · Work conducted selectively
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="brand-text muted">GillisT Enterprises</span>
      <span class="muted">© <span id="y"></span> All rights reserved.</span>
    </div>
  </footer>

  <script>
    document.getElementById("y").textContent = new Date().getFullYear();
  </script>
</body>
</html>
