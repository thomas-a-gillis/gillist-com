        <div class="contact-actions">
          <a class="btn btn-primary" href="mailto:inquiries@gillist.com">inquiries@gillist.com</a>
          <div class="contact-routes" aria-label="Specialized contact addresses">
            <a href="mailto:advisory@gillist.com">Advisory</a>
            <span aria-hidden="true">·</span>
            <a href="mailto:research@gillist.com">Research</a>
          </div>
          <p class="fine">
            United States · Remote engagements · Carefully scoped work
          </p>
        </div>
      </div>
